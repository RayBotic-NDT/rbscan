# Compiles schemas/*.json into the library, so the DLL and the Python module
# carry their schemas and need no data files at runtime.
#
# rbscan_embed_schemas(<out_cpp> <schema_dir>) writes a .cpp that defines
# raybotic::scan::detail::embedded_schemas(). Each file becomes a chain of raw
# string literals no longer than MSVC's 16 KB limit per literal.

function(rbscan_embed_schemas out_cpp schema_dir)
    file(GLOB _files CONFIGURE_DEPENDS "${schema_dir}/*.json")
    list(SORT _files)
    # Re-run when a schema's content changes, not only when files come or go.
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_files})

    set(_body "")
    foreach(_file IN LISTS _files)
        file(READ "${_file}" _text)
        get_filename_component(_name "${_file}" NAME)
        string(LENGTH "${_text}" _len)
        set(_pieces "")
        set(_pos 0)
        while(_pos LESS _len)
            string(SUBSTRING "${_text}" ${_pos} 8000 _piece)
            string(APPEND _pieces "        R\"rbscan_json(${_piece})rbscan_json\"\n")
            math(EXPR _pos "${_pos} + 8000")
        endwhile()
        string(APPEND _body "    {\"${_name}\",\n${_pieces}    },\n")
    endforeach()

    set(_content "// Generated by cmake/rbscan_embed_schemas.cmake - do not edit.
#include <string_view>
#include <utility>
#include <vector>

namespace raybotic::scan::detail {

const std::vector<std::pair<std::string_view, std::string_view>>& embedded_schemas() {
    static const std::vector<std::pair<std::string_view, std::string_view>> schemas = {
${_body}    };
    return schemas;
}

}  // namespace raybotic::scan::detail
")
    # Only touch the file when it changes, so a reconfigure does not rebuild.
    if(EXISTS "${out_cpp}")
        file(READ "${out_cpp}" _old)
    endif()
    if(NOT "${_old}" STREQUAL "${_content}")
        file(WRITE "${out_cpp}" "${_content}")
    endif()
endfunction()
